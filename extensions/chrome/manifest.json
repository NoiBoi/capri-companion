{
  "manifest_version": 3,
  "name": "Capri Life Context",
  "version": "1.1.0",
  "minimum_chrome_version": "120",
  "description": "Share bounded evidence from explicitly allowed, focused pages with your local Capri companion.",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:43129/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Capri page sharing" },
  "incognito": "not_allowed",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:43129" }
}
